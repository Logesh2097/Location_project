# Copy this file to .env and fill in the values. .env is never committed.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# true for local development only. Leave false anywhere else.
DJANGO_DEBUG=true

# Comma-separated host names this site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
